IMAGE=ghcr.io/xinhai-ai/csgofriberg:latest
APP_PORT_1=3000
APP_PORT_2=3001
TRUST_PROXY=true

# Generate independently with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes
GUEST_ID_SALT=replace-with-another-at-least-32-random-bytes
# 显示 ID 禁止包含的 2-5 位 Base36 片段，支持数字、字母或混合内容，英文逗号分隔。
DISPLAY_ID_FORBIDDEN_TOKENS=

POSTGRES_DB=csgofriberg
POSTGRES_USER=csgofriberg
# Use a URL-safe password because DB_URL embeds it directly.
POSTGRES_PASSWORD=replace-with-url-safe-password
# PostgreSQL data directory, relative to this Compose file by default.
PGDATA_PATH=./data/pgdata
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_ACQUIRE_TIMEOUT_MS=3000

REDIS_PREFIX=csgofriberg:
REDIS_COMMAND_TIMEOUT_MS=1500
# 多实例争用同一房间时允许等待 Redis 锁的最长时间。
ROOM_LOCK_WAIT_MS=1000
PASSWORD_WORKERS=1
PASSWORD_QUEUE_LIMIT=64
BCRYPT_ROUNDS=8
# 管理员选手 JSON 导入请求体上限，默认 2 MiB。
ADMIN_IMPORT_BODY_LIMIT_BYTES=2097152
DISCONNECT_FORFEIT_MS=30000

# 可选邮箱验证 SMTP。EMAIL_ALLOWED_SUFFIXES 为空表示不限制后缀；多个后缀用英文逗号分隔。
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_STARTTLS=true
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_VERIFY_BASE_URL=https://game.example.com
EMAIL_ALLOWED_SUFFIXES=
EMAIL_VERIFY_TTL_SECONDS=1800
# GeeTest is required in production. The public ID is returned to the browser at runtime.
GEETEST_CAPTCHA_ID=
GEETEST_PRIVATE_KEY=
GEETEST_VALIDATE_URL=https://gcaptcha4.geetest.com/validate
GEETEST_TIMEOUT_MS=3000

# Exact public browser origin, without a trailing slash.
CORS_ORIGINS=https://game.example.com

POW_DIFFICULTY=17
POW_REGISTER_DIFFICULTY=19
POW_CHALLENGE_TTL_SECONDS=120
POW_TOKEN_TTL_SECONDS=600
SHOW_LEADERBOARD=true

# 留空即关闭 Umami 统计。站点 ID 可在 Umami 网站设置中获取。
UMAMI_WEBSITE_ID=
# 自托管 Umami 时改为对应的脚本完整地址。
UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
