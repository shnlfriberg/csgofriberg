{
  "name": "csgofriberg",
  "version": "0.3.9",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=26"
  },
  "private": true,
  "description": "弗一把 - CS:GO/CS2 Major 选手猜测游戏",
  "scripts": {
    "dev": "node scripts/build-info.cjs run dev:app",
    "dev:app": "concurrently -n server,client -c blue,green \"pnpm --filter server dev\" \"pnpm --filter client dev\"",
    "build": "node scripts/build-info.cjs run build:app",
    "build:app": "pnpm build:pow && pnpm --filter client build && pnpm --filter server build",
    "test:version": "node --test scripts/build-info.test.cjs",
    "start": "pnpm --filter server start",
    "test": "pnpm --filter server test && pnpm --filter client test",
    "test:client": "pnpm --filter client test",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local.ps1 -Action start",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local.ps1 -Action stop",
    "local:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local.ps1 -Action test",
    "migrate": "pnpm --filter server migrate",
    "seed": "pnpm --filter server seed",
    "create-admin": "pnpm --filter server create-admin",
    "build:pow": "node scripts/build-pow.mjs",
    "loadtest": "pnpm --filter server loadtest"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
