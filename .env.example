# 服务端口
PORT=3000
# JWT 密钥,生产环境必须是至少 32 字节的随机值
JWT_SECRET=
# 访客显示 ID 的 HMAC 盐;可选,默认复用 JWT_SECRET,生产环境显式配置时至少 32 字节
GUEST_ID_SALT=
# 显示 ID 禁止包含的 2-5 位 Base36 片段，支持数字、字母或混合内容，英文逗号分隔。
DISPLAY_ID_FORBIDDEN_TOKENS=
# Redis 地址;生产环境建议设置 REDIS_REQUIRED=true,连接失败则拒绝启动
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=csgofriberg:
REDIS_REQUIRED=false
# PoW 默认约适合移动端亚秒级完成;允许范围 16-24 bit
POW_DIFFICULTY=17
# 注册使用更高难度的 PoW，默认比普通请求高 2 bit，移动端目标约 3 秒内完成。
POW_REGISTER_DIFFICULTY=19
POW_CHALLENGE_TTL_SECONDS=120
POW_TOKEN_TTL_SECONDS=600
# 允许访问 API 与 Socket.IO 的前端来源,逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000
# 仅在应用确实位于一层可信反向代理之后时启用；同时用于 HTTP 和 Socket.IO 真实 IP
TRUST_PROXY=false
# 数据库类型: sqlite | pg
DB_CLIENT=sqlite
# sqlite 时为文件路径;pg 时为连接串,如 postgres://user:pass@localhost:5432/csgofriberg
DB_URL=./data/csgofriberg.sqlite3
DB_POOL_MIN=2
DB_POOL_MAX=20
# 管理员通过 ADMIN_USERNAME/ADMIN_PASSWORD + pnpm create-admin 显式创建
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 可选邮箱验证 SMTP。EMAIL_ALLOWED_SUFFIXES 为空表示不限制后缀；用逗号分隔。
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_STARTTLS=true
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_VERIFY_BASE_URL=http://localhost:3000
EMAIL_ALLOWED_SUFFIXES=
EMAIL_VERIFY_TTL_SECONDS=1800

# 留空即关闭 Umami 统计。站点 ID 可在 Umami 网站设置中获取。
UMAMI_WEBSITE_ID=
# 自托管 Umami 时改为对应的脚本完整地址。
UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
